rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A task is private to the authenticated user recorded in its userId field.
    // Ownership is enforced on the server; client-side filters are not a security boundary.
    match /tasks/{taskId} {
      allow get, list: if request.auth != null
                       && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Deny all other collections and documents unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
